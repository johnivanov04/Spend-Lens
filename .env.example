# Spend Lens — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# Anything NEXT_PUBLIC_* is exposed to the browser; everything else is server-only.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS for privileged API routes (classification, imports).
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (required) ---
# Which provider the classification wrapper uses: anthropic | openai
AI_PROVIDER=anthropic
# Default classifier model: claude-haiku-4-5 (cheap/fast). Override if desired.
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email provider (optional; weekly summary is mocked if unset) ---
# resend | postmark | mailgun  (leave blank to mock)
EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_API_KEY=
MAILGUN_API_KEY=

# --- Stripe (optional; MVP ships a static pricing page, no checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
