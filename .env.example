# Spend Lens — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# Anything NEXT_PUBLIC_* is exposed to the browser; everything else is server-only.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS for privileged API routes (classification, imports).
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI classification (server-only; keys must NOT be NEXT_PUBLIC_) ---
# Provider: mock | anthropic | openai. Default "mock" works with no API key.
# If you pick anthropic/openai but the matching key is missing, it falls back to mock.
AI_PROVIDER=mock
# Optional model override. Defaults: anthropic -> claude-haiku-4-5, openai -> gpt-4o-mini.
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Mail (optional; weekly summary email is MOCKED by default) ---
# mock (default) | resend | none. The app never sends real email in the MVP;
# this only labels the weekly-summary page's email button.
MAIL_PROVIDER=mock
RESEND_API_KEY=
SUMMARY_EMAIL_FROM=

# --- Stripe (optional; MVP ships a static pricing page, no checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
